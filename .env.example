# LiveKit Cloud > your project > Settings > API keys.
# These three values must come from the SAME LiveKit project.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google AI Studio > voice-debugger project > API keys.
# Use a project on the Free tier with billing disabled.
GOOGLE_API_KEY=

# Connect directly to Google's API, not LiveKit Inference.
GEMINI_MODEL=gemini-3.8-live
